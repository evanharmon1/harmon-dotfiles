{
  "model": "Gemini 3.1 Pro (High)",
  "toolPermission": "proceed-in-sandbox",
  "artifactReviewPolicy": "always-proceed",
  "allowNonWorkspaceAccess": false,
  "enableTerminalSandbox": true,
  "statusLine": {
    "type": "command",
    "command": "{{ .chezmoi.homeDir }}/.gemini/antigravity-cli/statusline.sh",
    "enabled": true,
    "stack_with_default": false
  },
  "permissions": {
    "allow": [
      "command(task)",
      "command(ls -R \"$(git rev-parse --git-path deferred-findings)\" 2>/dev/null || echo \"no deferred-findings directory\")",
      "command(cat \"$(git rev-parse --git-path \"deferred-findings/$(git branch --show-current)\")\")",
      "command(gh)",
      "command(gh *)",
      "command(cat)",
      "command(cat *)",
      "command(ls)",
      "command(ls *)",
      "command(pwd)",
      "command(whoami)",
      "command(grep)",
      "command(grep *)",
      "command(find)",
      "command(find *)",
      "command(tree)",
      "command(tree *)",
      "command(head)",
      "command(head *)",
      "command(tail)",
      "command(tail *)",
      "command(git status)",
      "command(git status *)",
      "command(git log)",
      "command(git log *)",
      "command(git diff)",
      "command(git diff *)",
      "command(git show)",
      "command(git show *)",
      "command(git branch)",
      "command(git branch *)",
      "command(node --version)",
      "command(npm --version)"
    ]
  },
  "trustedWorkspaces": [
    "{{ .chezmoi.homeDir }}/git/harmon-init",
    "{{ .chezmoi.homeDir }}/git/harmon-devkit",
    "{{ .chezmoi.homeDir }}/git/orgs/ponderousdev/foreman",
    "{{ .chezmoi.homeDir }}/git/harmon-dotfiles",
    "{{ .chezmoi.homeDir }}/git/harmon-ops",
    "{{ .chezmoi.homeDir }}/git/harmon-infra",
    "{{ .chezmoi.homeDir }}/git/orgs/harmonops/harmon-infra",
    "{{ .chezmoi.homeDir }}/git/evanharmon-site",
    "{{ .chezmoi.homeDir }}/git/orgs/sommerlawn/sommerlawn-site",
    "{{ .chezmoi.homeDir }}/git/orgs/sommerlawn/sommerlawn-infra",
    "{{ .chezmoi.homeDir }}/git/orgs/ponderousdev/omator",
    "{{ .chezmoi.homeDir }}/git/orgs/ponderousdev/ponderous-infra",
    "{{ .chezmoi.homeDir }}/git/orgs/ponderousdev/ponderous-site",
    "{{ .chezmoi.homeDir }}/git/orgs/ponderousdev/lawnomator-site",
    "{{ .chezmoi.homeDir }}/git/orgs/ponderousdev/ponderous-docs"
  ]
}
