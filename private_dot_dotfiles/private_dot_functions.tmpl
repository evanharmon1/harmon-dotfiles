# chezmoi:managed (source: {{ .chezmoi.sourceFile }}) — edit via 'chezmoi edit' or in ~/git/harmon-dotfiles; direct edits are overwritten by the next 'chezmoi apply' (templates are never re-added)
# My Shell Functions

# Create a new directory and enter it
function mk() {
  mkdir -p "$@" && cd "$@" || exit
}


#==============================================================================
#                       git
#==============================================================================
# Git - stage all current changes, commit them, and push them to current remote branch.
# Argument: "commit message". If not present, defaults to "default message".
function gitsend() {
  git add -A
  git commit -m "${1:-"default message"}"
  git push
}

# Git - from any branch, checkout main, pull any changes, then switch back to the original branch.
function gitum() {
  local current_branch=$(git symbolic-ref --short HEAD)
  branch=${1:-$current_branch}
  git checkout main
  git pull
  git checkout "$branch"
}

# Function to return a number n, and then n+1 on subsequent calls.
# In order to ensure the global value, output the value to a file. Otherwise, value is reset from new terminal sessions via gitconfig e.g.
SEQN_FILE="$HOME/dotfiles/.seqn_counter"
seqn() {
    if [ ! -f "$SEQN_FILE" ]; then
        echo 1 > "$SEQN_FILE"
    else
        current=$(cat "$SEQN_FILE")
        echo $((current + 1)) > "$SEQN_FILE"
    fi
    cat "$SEQN_FILE"
}


#==============================================================================
#                       llm
#==============================================================================

# Use the tool llm to run qwen3 8b and pipe to glow for nicer markdown formatting
llmq8g() {
    tmpfile=$(mktemp)

    llm -m q8 \
        -o max_tokens 4096 \
        -o temperature 0.2 \
        "$@" | tee "$tmpfile"

    echo
    glow "$tmpfile"

    command rm "$tmpfile"
}

# Use the tool llm to run qwen3 30b and pipe to glow for nicer markdown formatting
llmq30g() {
    tmpfile=$(mktemp)

    llm -m q8 \
        -o max_tokens 12000 \
        -o temperature 0.2 \
        "$@" | tee "$tmpfile"

    echo
    glow "$tmpfile"

    command rm "$tmpfile"
}

e() {
{{- if eq .chezmoi.os "darwin" }}
  llm -m qc30 -s "Output ONLY the shell command. No explanation, no markdown, no code fences. Shell: zsh. OS: macOS." "$*"
{{- else }}
  llm -m qc30 -s "Output ONLY the shell command. No explanation, no markdown, no code fences. Shell: zsh. OS: Linux." "$*"
{{- end }}
}


#==============================================================================
#                       Claude Code
#==============================================================================

# Launch Claude Code with Kimi K3 without changing the parent shell environment.
# Provide the API key as KIMI_API_KEY (or Moonshot's MOONSHOT_API_KEY), ideally
# through `op run`.
claude-kimi() {
    local api_key="${KIMI_API_KEY:-${MOONSHOT_API_KEY:-}}"

    if [ -z "$api_key" ]; then
        echo "claude-kimi: KIMI_API_KEY or MOONSHOT_API_KEY is not set" >&2
        return 1
    fi

    (
        unset ANTHROPIC_API_KEY KIMI_API_KEY MOONSHOT_API_KEY
        export ANTHROPIC_BASE_URL="https://api.moonshot.ai/anthropic"
        export ANTHROPIC_AUTH_TOKEN="$api_key"
        export ANTHROPIC_MODEL="kimi-k3[1m]"
        export ANTHROPIC_DEFAULT_OPUS_MODEL="kimi-k3[1m]"
        export ANTHROPIC_DEFAULT_SONNET_MODEL="kimi-k3[1m]"
        export ANTHROPIC_DEFAULT_HAIKU_MODEL="kimi-k3[1m]"
        export ANTHROPIC_DEFAULT_FABLE_MODEL="kimi-k3[1m]"
        export CLAUDE_CODE_SUBAGENT_MODEL="kimi-k3[1m]"
        export ENABLE_TOOL_SEARCH="false"
        export CLAUDE_CODE_AUTO_COMPACT_WINDOW="1048576"
        export CLAUDE_CODE_EFFORT_LEVEL="max"
        command claude "$@"
    )
}

# Launch Claude Code with DeepSeek V4 Pro for primary work and V4 Flash for
# lightweight tiers and subagents, without changing the parent shell environment.
# Provide the API key as DEEPSEEK_API_KEY, ideally through `op run`.
claude-deepseek() {
    local api_key="${DEEPSEEK_API_KEY:-}"

    if [ -z "$api_key" ]; then
        echo "claude-deepseek: DEEPSEEK_API_KEY is not set" >&2
        return 1
    fi

    (
        unset ANTHROPIC_API_KEY DEEPSEEK_API_KEY
        export ANTHROPIC_BASE_URL="https://api.deepseek.com/anthropic"
        export ANTHROPIC_AUTH_TOKEN="$api_key"
        export ANTHROPIC_MODEL="deepseek-v4-pro[1m]"
        export ANTHROPIC_DEFAULT_OPUS_MODEL="deepseek-v4-pro[1m]"
        export ANTHROPIC_DEFAULT_SONNET_MODEL="deepseek-v4-pro[1m]"
        export ANTHROPIC_DEFAULT_HAIKU_MODEL="deepseek-v4-flash"
        export ANTHROPIC_DEFAULT_FABLE_MODEL="deepseek-v4-pro[1m]"
        export CLAUDE_CODE_SUBAGENT_MODEL="deepseek-v4-flash"
        export CLAUDE_CODE_EFFORT_LEVEL="max"
        command claude "$@"
    )
}
