{{- /* chezmoi:modify-template */ -}}
{{- /*
  Claude Code user settings (~/.claude/settings.json), evanharmon1/harmon-dotfiles#48.

  Claude Code writes this file itself (/model, plugin installs, auto-mode
  setup), so a whole-file target had two writers and drifted by design. This
  modify template gives each key one owner. chezmoi passes the live file as
  .chezmoi.stdin and:

  - enforced (.chezmoitemplates/claude-settings/enforced.json): replaced on
    every apply. permissions and hooks are authoritative and replaced whole,
    so the security config is exactly what is reviewed in git. enabledPlugins
    has the listed plugins forced on; plugins installed in-session are kept.
  - seeded (.chezmoitemplates/claude-settings/seeded.json): set only where
    the key is missing (a fresh machine); after that the live value wins, so
    /model and the other preferences stick.
  - runtime keys Claude Code writes harmlessly (the $runtime list: autoMode)
    pass through untouched;
  - every other key is removed. This is an allow list on purpose: settings
    that switch a control off or run a command (disableAllHooks, env,
    processWrapper, apiKeyHelper, enabledMcpjsonServers, ...) keep growing,
    so a deny list never converges. To keep a new setting, add it to
    enforced.json, seeded.json, or $runtime.

  While the live file already matches, it is kept byte-for-byte, so Claude
  Code's own key order never shows as drift. A correction re-serialises it:
  key order changes, values survive, a number beyond float64 precision would
  be rounded (Claude Code writes none), and a Claude Code write landing
  during the correction is lost.
*/ -}}
{{- $enforced := include ".chezmoitemplates/claude-settings/enforced.json" | fromJson -}}
{{- $seeded := include ".chezmoitemplates/claude-settings/seeded.json" | fromJson -}}
{{- $current := dict -}}
{{- $before := dict -}}
{{- if .chezmoi.stdin -}}
{{-   $current = fromJson .chezmoi.stdin -}}
{{-   $before = fromJson .chezmoi.stdin -}}
{{- end -}}
{{- $merged := $current -}}
{{- /* Seed by key presence, never by value: sprig's merge treats false as
       missing and would re-enable a preference turned off. Two levels deep,
       so a missing per-model entry or voice sub-setting is filled too. */ -}}
{{- range $key, $value := $seeded -}}
{{-   if not (hasKey $merged $key) -}}
{{-     $_ := set $merged $key $value -}}
{{-   else if and (kindIs "map" $value) (kindIs "map" (get $merged $key)) -}}
{{-     $live := get $merged $key -}}
{{-     range $sub, $subValue := $value -}}
{{-       if not (hasKey $live $sub) -}}
{{-         $_ := set $live $sub $subValue -}}
{{-       end -}}
{{-     end -}}
{{-   end -}}
{{- end -}}
{{- /* Enforce: replace whole, except plugins: each listed plugin is set to its
       managed value (true or false), and plugins installed in-session stay. */ -}}
{{- range $key, $value := $enforced -}}
{{-   if eq $key "enabledPlugins" -}}
{{-     $plugins := get $merged $key | default dict -}}
{{-     if not (kindIs "map" $plugins) -}}{{- $plugins = dict -}}{{- end -}}
{{-     range $plugin, $on := $value -}}
{{-       $_ := set $plugins $plugin $on -}}
{{-     end -}}
{{-     $_ := set $merged $key $plugins -}}
{{-   else -}}
{{-     $_ := set $merged $key $value -}}
{{-   end -}}
{{- end -}}
{{- /* Allow list: a key survives only if it is enforced, seeded, or one
       Claude Code writes harmlessly ($runtime). Everything else is removed,
       so a setting that switches a control off or runs a command (hook
       kill-switches, env, processWrapper, *Helper, MCP auto-approval, ...)
       can never ride along, however many such settings Claude Code adds. */ -}}
{{- $runtime := list "autoMode" -}}
{{- range $key := keys $merged -}}
{{-   if not (or (hasKey $enforced $key) (hasKey $seeded $key) (has $key $runtime)) -}}
{{-     $_ := unset $merged $key -}}
{{-   end -}}
{{- end -}}
{{- if and .chezmoi.stdin (eq (toJson $before) (toJson $merged)) -}}
{{- .chezmoi.stdin -}}
{{- else -}}
{{ toPrettyJson $merged }}
{{ end -}}
