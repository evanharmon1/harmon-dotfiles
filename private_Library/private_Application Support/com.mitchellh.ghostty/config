# Config syntax crash course
# ==========================
# # The config file consists of simple key-value pairs,
# # separated by equals signs.
# font-family = Iosevka
# window-padding-x = 2
#
# # Spacing around the equals sign does not matter.
# # All of these are identical:
# key=value
# key= value
# key =value
# key = value
#
# # Any line beginning with a # is a comment. It's not possible to put
# # a comment after a config option, since it would be interpreted as a
# # part of the value. For example, this will have a value of "#123abc":
# background = #123abc
#
# # Empty values are used to reset config keys to default.
# key =
#
# # Some config options have unique syntaxes for their value,
# # which is explained in the docs for that config option.
# # Just for example:
# resize-overlay-duration = 4s 200ms
theme = Catppuccin Frappe

# SSH integration. Ghostty sets TERM=xterm-ghostty, which is correct here and
# unknown almost everywhere else — so on a remote host without that terminfo
# entry, every ncurses program (vim, less, htop, tmux) fails with "unknown
# terminal type" or renders with broken keys and colors. Both features ship
# disabled (the default is `no-ssh-env,no-ssh-terminfo`).
#
#   ssh-terminfo  installs Ghostty's terminfo on the remote host on first
#                 connection and caches which hosts are done, so xterm-ghostty
#                 simply works there. Inspect or clear with `ghostty +ssh-cache`.
#   ssh-env       the fallback: when installation is not possible (no tic, a
#                 read-only or locked-down host), downgrade to xterm-256color
#                 and forward COLORTERM/TERM_PROGRAM rather than leaving the
#                 session with a terminfo name nothing recognizes.
#
# They compose deliberately: try the real entry, degrade to a working one. The
# rest of the defaults are kept explicitly because this key REPLACES the default
# list rather than adding to it — dropping `cursor`, `title`, or `path` here
# would silently turn those off.
shell-integration-features = cursor,no-sudo,title,ssh-env,ssh-terminfo,path

# Quick terminal (Guake/Quake style)
quick-terminal-position = top

# Bind F12 globally to toggle the drop-down terminal
keybind = global:cmd+opt+ctrl+g=toggle_quick_terminal

# Modify default split hotkeys so that I can use Cmd-D for select next occurrence in general
keybind = cmd+shift+d=new_split:right
keybind = opt+shift+d=new_split:down
